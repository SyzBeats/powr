{
  "name": "powr",
  "version": "0.0.0",
  "private": true,
  "description": "POWR: local-first, evidence-based training planner and tracker (PWA)",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @powr/web dev",
    "build": "pnpm --filter @powr/web build",
    "preview": "pnpm --filter @powr/web preview",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @powr/web e2e",
    "lighthouse": "pnpm --filter @powr/web lighthouse",
    "knip": "knip",
    "i18n:extract": "pnpm --filter @powr/web i18n:extract",
    "i18n:check": "pnpm --filter @powr/web i18n:check",
    "licence": "node tools/licence/src/cli.ts check",
    "licence:demo-gpl": "node tools/licence/src/demo-gpl.ts",
    "size": "pnpm --filter @powr/web size",
    "icons": "node tools/icons/src/generate.ts",
    "content:build": "node tools/content-build/src/cli.ts",
    "content:check": "node tools/content-build/src/cli.ts --check",
    "tokens:check": "node tools/tokens-check/src/cli.ts",
    "docker:build": "docker build -f deploy/Dockerfile -t powr-web:local .",
    "docker:run": "docker run --rm --name powr-web -p 8080:8080 powr-web:local",
    "docker:smoke": "node deploy/smoke.ts http://localhost:8080",
    "verify": "pnpm lint && pnpm format:check && pnpm tokens:check && pnpm knip && pnpm i18n:check && pnpm typecheck && pnpm test && pnpm build && pnpm licence && pnpm size && pnpm e2e"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "eslint-plugin-lingui": "0.16.0",
    "fast-check": "4.11.0",
    "knip": "6.48.0",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2008",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "packageManager": "pnpm@12.23.0"
}
