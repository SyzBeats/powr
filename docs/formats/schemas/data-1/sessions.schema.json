{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/sessions.json (dataVersion 1)",
  "description": "A JSON array of sessions records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "localDate": {
        "$ref": "#/$defs/localDate"
      },
      "startedAt": {
        "$ref": "#/$defs/instantTz"
      },
      "endedAt": {
        "$ref": "#/$defs/instantTz"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "finished",
          "partial",
          "discarded"
        ]
      },
      "versions": {
        "$ref": "#/$defs/versionStamp"
      }
    },
    "required": [
      "id",
      "localDate",
      "startedAt",
      "status",
      "versions"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    },
    "versionStamp": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "engine",
        "rules",
        "content"
      ],
      "additionalProperties": false,
      "description": "The engine, rules registry and exercise content versions that produced the record."
    }
  }
}
