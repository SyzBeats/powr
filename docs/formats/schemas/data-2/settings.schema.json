{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/settings.json (dataVersion 2)",
  "description": "A JSON array of settings records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "const": "me"
      },
      "theme": {
        "type": "string",
        "enum": [
          "light",
          "dark",
          "system"
        ]
      },
      "session": {
        "type": "object",
        "properties": {
          "restAutoStart": {
            "type": "boolean"
          },
          "restMode": {
            "type": "string",
            "enum": [
              "countdown",
              "countup"
            ]
          },
          "readinessCheckIn": {
            "type": "boolean"
          },
          "hintsOff": {
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "sessionVolume",
                "failure",
                "shortRest",
                "slowReps"
              ]
            }
          },
          "rounding": {
            "type": "string",
            "enum": [
              "nearestTiesDown",
              "down",
              "up"
            ]
          },
          "exercises": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "exerciseId": {
                  "type": "string",
                  "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
                },
                "manual": {
                  "type": "boolean"
                },
                "restAutoStart": {
                  "type": "boolean"
                },
                "perSide": {
                  "type": "boolean"
                }
              },
              "required": [
                "exerciseId"
              ],
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "weekStart": {
        "type": "integer",
        "minimum": 1,
        "maximum": 7
      },
      "overrides": {
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "paramId": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$"
            },
            "value": {},
            "exerciseId": {
              "type": "string",
              "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
            }
          },
          "required": [
            "paramId",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "insights": {
        "type": "object",
        "properties": {
          "streakGrace": {
            "type": "boolean"
          },
          "weeklySessionTarget": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 14
              },
              {
                "type": "null"
              }
            ]
          },
          "measurementSites": {
            "maxItems": 17,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "neck",
                "chest",
                "waist",
                "hips",
                "upperArmLeft",
                "upperArmRight",
                "thighLeft",
                "thighRight",
                "calfLeft",
                "calfRight",
                "skinfoldChest",
                "skinfoldAbdomen",
                "skinfoldThigh",
                "skinfoldTriceps",
                "skinfoldSuprailiac",
                "skinfoldSubscapular",
                "skinfoldMidaxillary"
              ]
            }
          },
          "scoreSource": {
            "type": "string",
            "enum": [
              "e1rm",
              "tested"
            ]
          },
          "division": {
            "type": "string",
            "enum": [
              "classic",
              "equipped"
            ]
          }
        },
        "additionalProperties": false
      },
      "backup": {
        "type": "object",
        "properties": {
          "reminderDays": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 7
                  },
                  {
                    "type": "number",
                    "const": 14
                  },
                  {
                    "type": "number",
                    "const": 30
                  }
                ]
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "reminderDays"
        ],
        "additionalProperties": false
      },
      "training": {
        "type": "object",
        "properties": {
          "effortScale": {
            "type": "string",
            "enum": [
              "rir",
              "rpe"
            ]
          },
          "rirInput": {
            "type": "string",
            "enum": [
              "chips",
              "decimal"
            ]
          },
          "warmups": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "display": {
        "type": "object",
        "properties": {
          "largeControls": {
            "type": "boolean"
          },
          "celebrations": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "alerts": {
        "type": "object",
        "properties": {
          "sound": {
            "type": "boolean"
          },
          "volume": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "vibration": {
            "type": "boolean"
          },
          "preAlert": {
            "type": "boolean"
          },
          "preAlertSeconds": {
            "anyOf": [
              {
                "type": "number",
                "const": 5
              },
              {
                "type": "number",
                "const": 10
              },
              {
                "type": "number",
                "const": 15
              }
            ]
          },
          "countdown": {
            "type": "boolean"
          },
          "restingNotice": {
            "type": "boolean"
          },
          "keepScreenOn": {
            "type": "boolean"
          },
          "setTimerLeadIn": {
            "type": "boolean"
          },
          "setTimerAutoStop": {
            "type": "boolean"
          },
          "tempoCues": {
            "type": "boolean"
          }
        },
        "required": [
          "sound",
          "volume",
          "vibration",
          "preAlert",
          "preAlertSeconds",
          "countdown",
          "restingNotice",
          "keepScreenOn"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "id",
      "theme"
    ],
    "additionalProperties": false
  }
}
