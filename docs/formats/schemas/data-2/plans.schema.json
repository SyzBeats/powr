{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/plans.json (dataVersion 2)",
  "description": "A JSON array of plans records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "ended"
        ]
      },
      "name": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "en"
        ],
        "additionalProperties": false
      },
      "templateId": {
        "type": "string",
        "pattern": "^tpl\\.[a-z0-9-]{1,60}$"
      },
      "style": {
        "type": "string",
        "enum": [
          "bodybuilding",
          "powerlifting",
          "powerbuilding"
        ]
      },
      "split": {
        "type": "string",
        "enum": [
          "fullBody",
          "upperLower",
          "upperLowerPpl",
          "pushPullLegs",
          "sbd"
        ]
      },
      "periodization": {
        "type": "string",
        "enum": [
          "linear",
          "dailyUndulating",
          "weeklyUndulating",
          "block"
        ]
      },
      "equipmentProfileId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "schedule": {
        "type": "object",
        "properties": {
          "weekdays": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 7
            }
          },
          "weekStartsOn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "sessionMinutes": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 10,
                "maximum": 300
              },
              {
                "type": "null"
              }
            ]
          },
          "startTimes": {
            "maxItems": 7,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "weekday": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 7
                },
                "time": {
                  "type": "string",
                  "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                }
              },
              "required": [
                "weekday",
                "time"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "weekdays",
          "weekStartsOn",
          "sessionMinutes",
          "startTimes"
        ],
        "additionalProperties": false
      },
      "variety": {
        "type": "boolean"
      },
      "seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "mesocycles": {
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "startDate": {
              "$ref": "#/$defs/localDate"
            },
            "accumulationWeeks": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "deloadWeeks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4
            },
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "active",
                "completed"
              ]
            },
            "level": {
              "type": "string",
              "enum": [
                "novice",
                "intermediate",
                "advanced"
              ]
            },
            "days": {
              "maxItems": 7,
              "type": "array",
              "items": {
                "$ref": "#/$defs/planDay"
              }
            },
            "targets": {
              "maxItems": 40,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "muscle": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "sets": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "band",
                      "priority",
                      "maintenance",
                      "recent",
                      "logged",
                      "user",
                      "timeBudget"
                    ]
                  },
                  "full": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 60
                  }
                },
                "required": [
                  "muscle",
                  "sets",
                  "source"
                ],
                "additionalProperties": false
              }
            },
            "liftTargets": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "lift": {
                    "type": "string",
                    "enum": [
                      "squat",
                      "bench",
                      "deadlift"
                    ]
                  },
                  "heavySets": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 60
                  }
                },
                "required": [
                  "lift",
                  "heavySets"
                ],
                "additionalProperties": false
              }
            },
            "next": {
              "type": "object",
              "properties": {
                "days": {
                  "maxItems": 7,
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/planDay"
                  }
                },
                "targets": {
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "muscle": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "sets": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      },
                      "source": {
                        "type": "string",
                        "enum": [
                          "band",
                          "priority",
                          "maintenance",
                          "recent",
                          "logged",
                          "user",
                          "timeBudget"
                        ]
                      },
                      "full": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 60
                      }
                    },
                    "required": [
                      "muscle",
                      "sets",
                      "source"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "days",
                "targets"
              ],
              "additionalProperties": false
            },
            "deload": {
              "type": "object",
              "properties": {
                "postponed": {
                  "type": "boolean"
                },
                "skipped": {
                  "type": "boolean"
                },
                "broughtForward": {
                  "type": "boolean"
                }
              },
              "required": [
                "postponed",
                "skipped",
                "broughtForward"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "index",
            "startDate",
            "accumulationWeeks",
            "deloadWeeks",
            "status",
            "level",
            "days",
            "targets",
            "liftTargets",
            "deload"
          ],
          "additionalProperties": false
        }
      },
      "createdAt": {
        "$ref": "#/$defs/instantTz"
      },
      "versions": {
        "$ref": "#/$defs/versionStamp"
      },
      "revision": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "dismissedIssues": {
        "maxItems": 500,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    },
    "required": [
      "id",
      "status",
      "name",
      "templateId",
      "style",
      "split",
      "periodization",
      "equipmentProfileId",
      "schedule",
      "variety",
      "seed",
      "mesocycles",
      "createdAt",
      "versions",
      "revision",
      "dismissedIssues"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    },
    "planDay": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "name": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        },
        "weekday": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "slots": {
          "maxItems": 20,
          "type": "array",
          "items": {
            "$ref": "#/$defs/planSlot"
          }
        }
      },
      "required": [
        "key",
        "name",
        "weekday",
        "slots"
      ],
      "additionalProperties": false,
      "description": "One training day of a plan week (weekday 1 = Monday … 7 = Sunday)."
    },
    "planSlot": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "exerciseId": {
          "type": "string",
          "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
        },
        "pattern": {
          "type": "string",
          "enum": [
            "squat",
            "hinge",
            "horizontalPush",
            "verticalPush",
            "horizontalPull",
            "verticalPull",
            "lunge",
            "kneeExtension",
            "kneeFlexion",
            "elbowFlexion",
            "elbowExtension",
            "shoulderAbduction",
            "hipExtension",
            "hipAbduction",
            "hipAdduction",
            "calf",
            "core",
            "carry",
            "shoulderHorizontalAdduction",
            "shoulderHorizontalAbduction",
            "shrug",
            "wristFlexion",
            "wristExtension"
          ]
        },
        "targets": {
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 64
          }
        },
        "priority": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "optional"
          ]
        },
        "goal": {
          "type": "string",
          "enum": [
            "hypertrophy",
            "strength"
          ]
        },
        "lift": {
          "type": "string",
          "enum": [
            "squat",
            "bench",
            "deadlift"
          ]
        },
        "allowVariants": {
          "type": "boolean"
        },
        "intensity": {
          "type": "string",
          "enum": [
            "heavy",
            "moderate",
            "light"
          ]
        },
        "prescription": {
          "$ref": "#/$defs/prescription"
        },
        "progression": {
          "type": "string",
          "enum": [
            "doubleProgression",
            "rpe",
            "linear",
            "apre"
          ]
        },
        "restSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1800
        },
        "loadPct": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0,
              "maximum": 150
            },
            "max": {
              "type": "number",
              "minimum": 0,
              "maximum": 150
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "locked": {
          "type": "boolean"
        }
      },
      "required": [
        "key",
        "exerciseId",
        "pattern",
        "targets",
        "priority",
        "goal",
        "prescription",
        "progression",
        "restSeconds"
      ],
      "additionalProperties": false,
      "description": "One exercise of a plan day with its prescription and progression."
    },
    "prescription": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "doubleProgression"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "repRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "rir": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "mode",
            "sets",
            "repRange",
            "rir"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "rpe"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "repRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "rir": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "mode",
            "sets",
            "repRange",
            "rir"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "topBackoff"
            },
            "top": {
              "type": "object",
              "properties": {
                "repRange": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "rir": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "repRange",
                "rir"
              ],
              "additionalProperties": false
            },
            "backoff": {
              "type": "object",
              "properties": {
                "sets": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 20
                },
                "repRange": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "rir": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "sets",
                "repRange",
                "rir"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "top",
            "backoff"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "percent"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "repRange": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                },
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "pct": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 120
            },
            "of": {
              "type": "string",
              "enum": [
                "e1rm",
                "trainingMax"
              ]
            }
          },
          "required": [
            "mode",
            "sets",
            "repRange",
            "pct",
            "of"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "fixed"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "reps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "load": {
              "$ref": "#/$defs/mass"
            }
          },
          "required": [
            "mode",
            "sets",
            "reps",
            "load"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "amrap"
            },
            "load": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "pct": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 120
                    }
                  },
                  "required": [
                    "pct"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "fixed": {
                      "$ref": "#/$defs/mass"
                    }
                  },
                  "required": [
                    "fixed"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "stopAtRir": {
              "type": "number",
              "minimum": 0,
              "maximum": 10
            }
          },
          "required": [
            "mode",
            "load"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "timed"
            },
            "sets": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "durationS": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600
            }
          },
          "required": [
            "mode",
            "sets",
            "durationS"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "technique"
            },
            "technique": {
              "type": "string",
              "enum": [
                "drop",
                "restPause",
                "myoReps",
                "cluster",
                "lengthenedPartials",
                "partialExtension"
              ]
            },
            "base": {
              "type": "object",
              "properties": {
                "sets": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "repRange": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    },
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                },
                "rir": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 10
                    }
                  ],
                  "items": false,
                  "minItems": 2,
                  "maxItems": 2
                }
              },
              "required": [
                "sets",
                "repRange",
                "rir"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "mode",
            "technique",
            "base"
          ],
          "additionalProperties": false
        }
      ],
      "description": "How an exercise is prescribed, chosen by mode. Ranges are [min, max] with min <= max; RIR (reps in reserve) moves in steps of 0.5."
    },
    "versionStamp": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "rules": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "engine",
        "rules",
        "content"
      ],
      "additionalProperties": false,
      "description": "The engine, rules registry and exercise content versions that produced the record."
    }
  }
}
