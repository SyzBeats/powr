{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/customExercises.json (dataVersion 2)",
  "description": "A JSON array of customExercises records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^cx\\.[a-z0-9-]{1,80}$"
      },
      "name": {
        "type": "object",
        "properties": {
          "en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "en"
        ],
        "additionalProperties": false
      },
      "synonyms": {
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      },
      "pattern": {
        "type": "string",
        "enum": [
          "squat",
          "hinge",
          "horizontalPush",
          "verticalPush",
          "horizontalPull",
          "verticalPull",
          "lunge",
          "kneeExtension",
          "kneeFlexion",
          "elbowFlexion",
          "elbowExtension",
          "shoulderAbduction",
          "hipExtension",
          "hipAbduction",
          "hipAdduction",
          "calf",
          "core",
          "carry",
          "shoulderHorizontalAdduction",
          "shoulderHorizontalAbduction",
          "shrug",
          "wristFlexion",
          "wristExtension"
        ]
      },
      "mechanics": {
        "type": "string",
        "enum": [
          "compound",
          "isolation"
        ]
      },
      "variantOf": {
        "type": "string",
        "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
      },
      "substitutionGroups": {
        "maxItems": 10,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^sg\\.[a-z0-9-]{1,60}$"
        }
      },
      "equipment": {
        "type": "object",
        "properties": {
          "allOf": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 80
                },
                {
                  "type": "string",
                  "pattern": "^ce\\.[0-9a-z-]{1,64}$"
                }
              ]
            }
          },
          "anyOf": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "minItems": 1,
              "maxItems": 30,
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 80
                  },
                  {
                    "type": "string",
                    "pattern": "^ce\\.[0-9a-z-]{1,64}$"
                  }
                ]
              }
            }
          }
        },
        "required": [
          "allOf",
          "anyOf"
        ],
        "additionalProperties": false
      },
      "muscles": {
        "minItems": 1,
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "muscle": {
              "type": "string",
              "maxLength": 64
            },
            "credit": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 0.5
                },
                {
                  "type": "number",
                  "const": 0.25
                },
                {
                  "type": "number",
                  "const": 0
                }
              ]
            },
            "evidence": {
              "type": "string",
              "enum": [
                "H",
                "EMG",
                "C"
              ]
            },
            "source": {
              "type": "string",
              "maxLength": 80,
              "pattern": "^src\\.[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
            }
          },
          "required": [
            "muscle",
            "credit",
            "evidence",
            "source"
          ],
          "additionalProperties": false
        }
      },
      "load": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "barbell",
              "dumbbell",
              "machine",
              "bodyweightAdded",
              "bodyweightAssisted",
              "band",
              "timed"
            ]
          },
          "curveClass": {
            "type": "string",
            "enum": [
              "equation",
              "legPressLike",
              "pooled"
            ]
          },
          "unilateral": {
            "type": "boolean"
          },
          "bodyweightLoaded": {
            "type": "boolean"
          },
          "increment": {
            "$ref": "#/$defs/mass"
          }
        },
        "required": [
          "type",
          "curveClass",
          "unilateral",
          "bodyweightLoaded"
        ],
        "additionalProperties": false
      },
      "defaults": {
        "type": "object",
        "properties": {
          "repRange": {
            "type": "object",
            "properties": {
              "hypertrophy": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              },
              "strength": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  },
                  {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 100
                  }
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            },
            "required": [
              "hypertrophy",
              "strength"
            ],
            "additionalProperties": false
          },
          "restClass": {
            "type": "string",
            "enum": [
              "strength",
              "hypertrophyCompound",
              "hypertrophyIsolation"
            ]
          },
          "tempo": {
            "type": "string",
            "pattern": "^\\d{1,2}-\\d{1,2}-(?:X|\\d{1,2})-\\d{1,2}$"
          },
          "fixedRom": {
            "type": "boolean"
          },
          "stretchEmphasis": {
            "type": "boolean"
          }
        },
        "required": [
          "repRange",
          "restClass",
          "tempo",
          "fixedRom",
          "stretchEmphasis"
        ],
        "additionalProperties": false
      },
      "ranking": {
        "type": "object",
        "properties": {
          "overloadSuitability": {
            "anyOf": [
              {
                "type": "number",
                "const": 0
              },
              {
                "type": "number",
                "const": 1
              },
              {
                "type": "number",
                "const": 2
              },
              {
                "type": "number",
                "const": 3
              }
            ]
          },
          "subRegions": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 64
            }
          }
        },
        "required": [
          "overloadSuitability"
        ],
        "additionalProperties": false
      },
      "cues": {
        "maxItems": 6,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "en": {
              "type": "string",
              "minLength": 1,
              "maxLength": 140
            }
          },
          "required": [
            "en"
          ],
          "additionalProperties": false
        }
      },
      "custom": {
        "type": "boolean",
        "const": true
      },
      "userRated": {
        "type": "boolean"
      },
      "status": {
        "type": "string",
        "enum": [
          "active",
          "deprecated"
        ]
      },
      "replacedBy": {
        "type": "string",
        "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
      },
      "createdAt": {
        "$ref": "#/$defs/instantTz"
      },
      "updatedAt": {
        "$ref": "#/$defs/instantTz"
      },
      "copiedFrom": {
        "type": "string",
        "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
      }
    },
    "required": [
      "id",
      "name",
      "synonyms",
      "pattern",
      "mechanics",
      "substitutionGroups",
      "equipment",
      "muscles",
      "load",
      "defaults",
      "ranking",
      "cues",
      "custom",
      "status",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    }
  }
}
