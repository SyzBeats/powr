{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/profile.json (dataVersion 2)",
  "description": "A JSON array of profile records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "const": "me"
      },
      "displayName": {
        "type": "string",
        "maxLength": 120
      },
      "units": {
        "type": "object",
        "properties": {
          "load": {
            "type": "string",
            "enum": [
              "kg",
              "lb"
            ]
          },
          "bodyweight": {
            "type": "string",
            "enum": [
              "kg",
              "lb"
            ]
          },
          "length": {
            "type": "string",
            "enum": [
              "cm",
              "in"
            ]
          }
        },
        "required": [
          "load",
          "bodyweight",
          "length"
        ],
        "additionalProperties": false
      },
      "sex": {
        "type": "string",
        "enum": [
          "female",
          "male",
          "preferNotToSay"
        ]
      },
      "referenceSet": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "male",
              "female"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "birthYear": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 1900,
            "maximum": 2100
          },
          {
            "type": "null"
          }
        ]
      },
      "height": {
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 300
              },
              "unit": {
                "type": "string",
                "enum": [
                  "cm",
                  "in"
                ]
              }
            },
            "required": [
              "value",
              "unit"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "style": {
        "type": "string",
        "enum": [
          "bodybuilding",
          "powerlifting",
          "powerbuilding"
        ]
      },
      "phase": {
        "type": "string",
        "enum": [
          "bulk",
          "cut",
          "maintain",
          "notTracking"
        ]
      },
      "experience": {
        "type": "object",
        "properties": {
          "trainingAge": {
            "type": "string",
            "enum": [
              "under6Months",
              "months6To24",
              "years2To5",
              "over5Years"
            ]
          },
          "timeOff": {
            "type": "string",
            "enum": [
              "upTo1Week",
              "weeks1To2",
              "weeks2To4",
              "months1To2",
              "over2Months"
            ]
          },
          "rpeFamiliarity": {
            "type": "string",
            "enum": [
              "none",
              "some",
              "experienced"
            ]
          },
          "recentVolume": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "muscle": {
                  "type": "string",
                  "maxLength": 64
                },
                "sets": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "muscle",
                "sets"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "trainingAge",
          "timeOff",
          "rpeFamiliarity",
          "recentVolume"
        ],
        "additionalProperties": false
      },
      "levelOverride": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "novice",
              "intermediate",
              "advanced"
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "priorities": {
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 64
        }
      },
      "avoid": {
        "type": "object",
        "properties": {
          "exercises": {
            "maxItems": 500,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
            }
          },
          "patterns": {
            "maxItems": 23,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "squat",
                "hinge",
                "horizontalPush",
                "verticalPush",
                "horizontalPull",
                "verticalPull",
                "lunge",
                "kneeExtension",
                "kneeFlexion",
                "elbowFlexion",
                "elbowExtension",
                "shoulderAbduction",
                "hipExtension",
                "hipAbduction",
                "hipAdduction",
                "calf",
                "core",
                "carry",
                "shoulderHorizontalAdduction",
                "shoulderHorizontalAbduction",
                "shrug",
                "wristFlexion",
                "wristExtension"
              ]
            }
          }
        },
        "required": [
          "exercises",
          "patterns"
        ],
        "additionalProperties": false
      },
      "preferredExercises": {
        "maxItems": 500,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
        }
      },
      "hiddenExercises": {
        "maxItems": 500,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
        }
      },
      "baselines": {
        "maxItems": 20,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "exerciseId": {
              "type": "string",
              "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
            },
            "kind": {
              "type": "string",
              "enum": [
                "oneRepMax",
                "recentSet"
              ]
            },
            "load": {
              "$ref": "#/$defs/mass"
            },
            "reps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "rir": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 10
                },
                {
                  "type": "null"
                }
              ]
            },
            "date": {
              "$ref": "#/$defs/localDate"
            }
          },
          "required": [
            "exerciseId",
            "kind",
            "load",
            "reps",
            "rir"
          ],
          "additionalProperties": false
        }
      },
      "createdAt": {
        "$ref": "#/$defs/instantTz"
      },
      "updatedAt": {
        "$ref": "#/$defs/instantTz"
      }
    },
    "required": [
      "id",
      "units",
      "sex",
      "referenceSet",
      "birthYear",
      "height",
      "style",
      "phase",
      "experience",
      "levelOverride",
      "priorities",
      "avoid",
      "preferredExercises",
      "baselines",
      "createdAt",
      "updatedAt"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    }
  }
}
