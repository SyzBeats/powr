{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/exerciseUserData.json (dataVersion 2)",
  "description": "A JSON array of exerciseUserData records, sorted by exerciseId. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "exerciseId": {
        "type": "string",
        "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
      },
      "setup": {
        "maxItems": 12,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "enum": [
                "seat",
                "backrest",
                "pin",
                "handle",
                "grip",
                "stance",
                "rack",
                "safeties",
                "other"
              ]
            },
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "required": [
            "field",
            "value"
          ],
          "additionalProperties": false
        }
      },
      "note": {
        "type": "string",
        "maxLength": 2000
      },
      "trainingMax": {
        "$ref": "#/$defs/mass"
      },
      "updatedAt": {
        "$ref": "#/$defs/instantTz"
      }
    },
    "required": [
      "exerciseId",
      "setup",
      "updatedAt"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    }
  }
}
