{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/measurements.json (dataVersion 2)",
  "description": "A JSON array of measurements records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "site": {
        "type": "string",
        "enum": [
          "neck",
          "chest",
          "waist",
          "hips",
          "upperArmLeft",
          "upperArmRight",
          "thighLeft",
          "thighRight",
          "calfLeft",
          "calfRight",
          "skinfoldChest",
          "skinfoldAbdomen",
          "skinfoldThigh",
          "skinfoldTriceps",
          "skinfoldSuprailiac",
          "skinfoldSubscapular",
          "skinfoldMidaxillary"
        ]
      },
      "localDate": {
        "$ref": "#/$defs/localDate"
      },
      "measuredAt": {
        "$ref": "#/$defs/instantTz"
      },
      "value": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 500
      },
      "unit": {
        "type": "string",
        "enum": [
          "cm",
          "in",
          "mm"
        ]
      },
      "note": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "required": [
      "id",
      "site",
      "localDate",
      "measuredAt",
      "value",
      "unit"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    }
  }
}
