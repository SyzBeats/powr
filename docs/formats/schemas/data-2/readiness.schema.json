{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/readiness.json (dataVersion 2)",
  "description": "A JSON array of readiness records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "localDate": {
        "$ref": "#/$defs/localDate"
      },
      "recordedAt": {
        "$ref": "#/$defs/instantTz"
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "items": {
        "type": "object",
        "properties": {
          "sleepHours": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              {
                "type": "null"
              }
            ]
          },
          "sleepQuality": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "energy": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "soreness": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "stress": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "motivation": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 5
              },
              {
                "type": "null"
              }
            ]
          },
          "prs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false
      },
      "soreMuscles": {
        "maxItems": 40,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "muscle": {
              "type": "string",
              "maxLength": 64
            },
            "rating": {
              "type": "integer",
              "minimum": 1,
              "maximum": 5
            }
          },
          "required": [
            "muscle",
            "rating"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "localDate",
      "recordedAt",
      "items"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    }
  }
}
