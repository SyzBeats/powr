{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/sets.json (dataVersion 2)",
  "description": "A JSON array of sets records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "sessionId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "exerciseId": {
        "type": "string",
        "pattern": "^(ex|cx)\\.[a-z0-9-]{1,80}$"
      },
      "index": {
        "type": "integer",
        "minimum": 0,
        "maximum": 999
      },
      "type": {
        "type": "string",
        "enum": [
          "warmup",
          "working",
          "top",
          "backoff",
          "amrap",
          "timed"
        ]
      },
      "load": {
        "anyOf": [
          {
            "$ref": "#/$defs/mass"
          },
          {
            "type": "null"
          }
        ]
      },
      "reps": {
        "anyOf": [
          {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          {
            "type": "null"
          }
        ]
      },
      "effort": {
        "type": "object",
        "properties": {
          "rir": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string",
            "enum": [
              "entered",
              "none"
            ]
          },
          "openEnded": {
            "type": "boolean"
          }
        },
        "required": [
          "rir",
          "source"
        ],
        "additionalProperties": false
      },
      "state": {
        "type": "string",
        "enum": [
          "done",
          "skipped"
        ]
      },
      "performedAt": {
        "$ref": "#/$defs/instantTz"
      },
      "localDate": {
        "$ref": "#/$defs/localDate"
      },
      "slotKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "setKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 40
      },
      "technique": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "drop",
              "restPause",
              "myoReps",
              "cluster",
              "lengthenedPartials",
              "partialExtension"
            ]
          },
          "units": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "repsLeft": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      },
      "repsRight": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1000
      },
      "durationMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 86400000
      },
      "flags": {
        "type": "object",
        "properties": {
          "failure": {
            "type": "boolean"
          },
          "failedRep": {
            "type": "boolean"
          },
          "pain": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      },
      "restBeforeMs": {
        "type": "integer",
        "minimum": 0,
        "maximum": 8640000000000000
      },
      "prescription": {
        "type": "object",
        "properties": {
          "load": {
            "anyOf": [
              {
                "$ref": "#/$defs/mass"
              },
              {
                "type": "null"
              }
            ]
          },
          "reps": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "rir": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10
              },
              {
                "type": "null"
              }
            ]
          },
          "durationS": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600
          }
        },
        "required": [
          "load",
          "reps",
          "rir"
        ],
        "additionalProperties": false
      },
      "note": {
        "type": "string",
        "maxLength": 2000
      }
    },
    "required": [
      "id",
      "sessionId",
      "exerciseId",
      "index",
      "type",
      "load",
      "reps",
      "effort",
      "state",
      "performedAt",
      "localDate"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "instantTz": {
      "type": "object",
      "properties": {
        "epochMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8640000000000000
        },
        "offsetMin": {
          "type": "integer",
          "minimum": -1080,
          "maximum": 1080
        },
        "zone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "epochMs",
        "offsetMin",
        "zone"
      ],
      "additionalProperties": false,
      "description": "A moment in time: epochMs is milliseconds since 1970-01-01T00:00:00Z (UTC), offsetMin the offset from UTC in minutes at that moment, zone the IANA time zone name (for example Europe/Zurich)."
    },
    "localDate": {
      "type": "string",
      "description": "A calendar day as YYYY-MM-DD in the user's local time zone. It must be a real date (2026-02-30 is rejected).",
      "format": "date"
    },
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    }
  }
}
