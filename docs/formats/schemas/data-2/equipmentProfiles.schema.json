{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: data/equipmentProfiles.json (dataVersion 2)",
  "description": "A JSON array of equipmentProfiles records, sorted by id. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "isDefault": {
        "type": "boolean"
      },
      "presetId": {
        "type": "string",
        "pattern": "^preset\\.[a-z0-9-]{1,60}$"
      },
      "items": {
        "maxItems": 200,
        "type": "array",
        "items": {
          "type": "string",
          "maxLength": 80
        }
      },
      "customItems": {
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^ce\\.[0-9a-z-]{1,64}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "increment": {
              "$ref": "#/$defs/mass"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        }
      },
      "unit": {
        "type": "string",
        "enum": [
          "kg",
          "lb"
        ]
      },
      "bars": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "maxLength": 80
            },
            "weight": {
              "$ref": "#/$defs/mass"
            }
          },
          "required": [
            "item",
            "weight"
          ],
          "additionalProperties": false
        }
      },
      "plates": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500
            },
            "pairs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "weight",
            "pairs"
          ],
          "additionalProperties": false
        }
      },
      "microplates": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 500
            },
            "pairs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50
            }
          },
          "required": [
            "weight",
            "pairs"
          ],
          "additionalProperties": false
        }
      },
      "collarWeight": {
        "type": "number",
        "minimum": 0,
        "maximum": 50
      },
      "dumbbells": {
        "anyOf": [
          {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "weights": {
                    "maxItems": 200,
                    "type": "array",
                    "items": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 500
                    }
                  }
                },
                "required": [
                  "weights"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "from": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 500
                  },
                  "to": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 500
                  },
                  "step": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "from",
                  "to",
                  "step"
                ],
                "additionalProperties": false
              }
            ]
          },
          {
            "type": "null"
          }
        ]
      },
      "kettlebells": {
        "maxItems": 50,
        "type": "array",
        "items": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 200
        }
      },
      "stacks": {
        "maxItems": 60,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "item": {
              "type": "string",
              "maxLength": 80
            },
            "increment": {
              "$ref": "#/$defs/mass"
            },
            "addOns": {
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 100
              }
            }
          },
          "required": [
            "item",
            "increment"
          ],
          "additionalProperties": false
        }
      },
      "bands": {
        "maxItems": 30,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            },
            "resistance": {
              "$ref": "#/$defs/mass"
            }
          },
          "required": [
            "label"
          ],
          "additionalProperties": false
        }
      }
    },
    "required": [
      "id",
      "name",
      "isDefault",
      "items",
      "customItems",
      "unit",
      "bars",
      "plates",
      "microplates",
      "collarWeight",
      "dumbbells",
      "kettlebells",
      "stacks",
      "bands"
    ],
    "additionalProperties": false
  },
  "$defs": {
    "mass": {
      "type": "object",
      "properties": {
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "enum": [
            "kg",
            "lb"
          ]
        }
      },
      "required": [
        "value",
        "unit"
      ],
      "additionalProperties": false,
      "description": "A weight with its unit. Converted to kg, the value lies between -500 and 2000; a negative load is assistance (for example a machine-assisted pull-up)."
    }
  }
}
