{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "POWR backup: manifest.json (formatVersion 1)",
  "description": "The first entry of every POWR backup ZIP: versions, creation time, record counts and the SHA-256 checksums of the data entries. Generated by `pnpm formats:schemas` from the Zod schemas the import uses (packages/formats); do not edit. Rules JSON Schema cannot express are listed in docs/formats/backup-format.md.",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "powr-backup"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "dataVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "app": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "maxLength": 64
        },
        "build": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": [
        "version",
        "build"
      ],
      "additionalProperties": false
    },
    "rulesVersion": {
      "type": "string",
      "maxLength": 64
    },
    "contentVersion": {
      "type": "string",
      "maxLength": 64
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "backupId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "part": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "data"
        },
        "index": {
          "type": "number",
          "const": 1
        },
        "count": {
          "type": "number",
          "const": 1
        }
      },
      "required": [
        "kind",
        "index",
        "count"
      ],
      "additionalProperties": false
    },
    "encrypted": {
      "type": "boolean",
      "const": false
    },
    "counts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "meta",
          "settings",
          "sessions",
          "sets",
          "profile",
          "equipmentProfiles",
          "plans",
          "plannedSessions",
          "breaks",
          "meets",
          "bodyweights",
          "readiness",
          "customExercises",
          "exerciseUserData",
          "measurements"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "dateRange": {
      "type": "object",
      "properties": {
        "from": {
          "type": [
            "string",
            "null"
          ]
        },
        "to": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "entries": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^data\\/[a-zA-Z]+\\.json$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "records": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "bytes",
          "records",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "contentDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "formatVersion",
    "dataVersion",
    "app",
    "rulesVersion",
    "contentVersion",
    "createdAt",
    "backupId",
    "part",
    "encrypted",
    "counts",
    "dateRange",
    "entries",
    "contentDigest"
  ],
  "additionalProperties": false
}
