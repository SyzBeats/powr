{
  "name": "@powr/rules",
  "version": "0.0.0",
  "private": true,
  "description": "Rules registry: parameter schema, data, source registry and resolver.",
  "type": "module",
  "sideEffects": [
    "./src/zod.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./resolve": "./src/resolve.ts",
    "./sources": "./src/sources/index.ts",
    "./sources/node": "./scripts/sources.ts",
    "./build/node": "./scripts/build.ts"
  },
  "scripts": {
    "build": "node --import ./scripts/ts-resolve.ts scripts/build.ts"
  },
  "dependencies": {
    "@powr/domain": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
