{
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "oxc.enable": true,
  "typescript.experimental.useTsgo": true,
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.exclude": {
    ".tsbuild": true
  },
  "search.exclude": {
    "**/routeTree.gen.ts": true,
    "pnpm-lock.yaml": true
  }
}
