{
  "name": "@powr/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#ui/button-class": "./src/ui/button-class.ts",
    "#ui/cn": "./src/ui/cn.ts",
    "#ui/*": "./src/ui/*.tsx"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/i18n-check.ts && vite build",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:kill": "POWR_KILLS=${POWR_KILLS:-200} POWR_KILL_SEED=${POWR_KILL_SEED:-$(date +%s)} playwright test e2e/kill.spec.ts",
    "lighthouse": "node scripts/lighthouse.ts",
    "size": "size-limit && node scripts/precache-size.ts && node scripts/startup-check.ts",
    "i18n:extract": "lingui extract --clean --overwrite",
    "i18n:check": "node scripts/i18n-check.ts",
    "ui:add": "node scripts/ui-add.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@lingui/core": "6.12.0",
    "@lingui/react": "6.12.0",
    "@powr/application": "workspace:*",
    "@powr/content": "workspace:*",
    "@powr/domain": "workspace:*",
    "@powr/formats": "workspace:*",
    "@powr/rules": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dexie": "4.4.7",
    "echarts": "6.1.0",
    "lucide-react": "1.78.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "8.1.2",
    "@lhci/cli": "0.16.1",
    "@lingui/cli": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@lingui/vite-plugin": "6.12.0",
    "@playwright/test": "1.65.1",
    "@powr/tools-licence": "workspace:*",
    "@powr/tools-release-notes": "workspace:*",
    "@rolldown/plugin-babel": "0.3.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/router-plugin": "1.169.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.1",
    "axe-core": "4.14.1",
    "babel-plugin-react-compiler": "1.0.0",
    "fake-indexeddb": "6.2.8",
    "fflate": "0.8.3",
    "playwright": "1.65.1",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.5",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0"
  }
}
